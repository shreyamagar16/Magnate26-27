# Server-only environment variables.
# NEVER prefix any of these with NEXT_PUBLIC_ — they must NOT be exposed to the browser.
# Real values go in .env.local (gitignored) and in Vercel project environment variables.

# Supabase credentials
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# CSV export protection — generate with: openssl rand -hex 32
# Pass as: Authorization: Bearer <value>
# See app/api/export/route.js for usage instructions.
EXPORT_SECRET=
